{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!pnpm-lock.yaml",
      "!schemas",
      "!docs/api",
      "!tests/fixtures/full-game/content",
      "!template/content",
      "!template/replays"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["src/features/web/library/**/*.svg"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    },
    {
      "includes": ["template/index.html"],
      "linter": { "rules": { "a11y": { "useHtmlLang": "off" } } }
    }
  ]
}
