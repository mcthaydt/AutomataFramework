{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "enum": [
        1,
        2
      ]
    },
    "framework": {
      "type": "string"
    },
    "tickHz": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "schemaHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "ticks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "tick",
          "source",
          "seq",
          "type",
          "payload"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        },
        "required": [
          "tick",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "finalHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "framework",
    "tickHz",
    "seed",
    "contentHash",
    "ticks",
    "commands",
    "checks",
    "finalHash",
    "meta"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "title": "Replay"
}
