{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "number",
          "const": 1,
          "description": "The version of this file format. 1 for rows of steps."
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "description": "A name for this track, like \"meadow\". It matches the file name."
        },
        "tempo": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300,
          "description": "Beats a minute, from 30 to 300."
        },
        "stepsPerBeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "How many steps make one beat, from 1 to 8."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How loud the whole track is, from 0 (silent) to 1 (full)."
        },
        "loop": {
          "type": "boolean",
          "description": "True if the track starts again when it ends."
        },
        "parts": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "description": "A name for this part, like \"bass\"."
                  },
                  "kind": {
                    "type": "string",
                    "const": "tone",
                    "description": "A part that plays notes."
                  },
                  "wave": {
                    "type": "string",
                    "enum": [
                      "sine",
                      "square",
                      "sawtooth",
                      "triangle"
                    ],
                    "description": "The shape of the wave: how the notes sound."
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "How loud this part is, from 0 (silent) to 1 (full)."
                  },
                  "notes": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "description": "Rows of steps, separated by one space. A note like C4 or F#3, - for a rest, = to hold the note before."
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "wave",
                  "volume",
                  "notes"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "description": "A name for this part, like \"drums\"."
                  },
                  "kind": {
                    "type": "string",
                    "const": "drums",
                    "description": "A part that plays drum hits."
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "How loud this part is, from 0 (silent) to 1 (full)."
                  },
                  "notes": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "description": "Rows of steps, separated by one space. A note like C4 or F#3, - for a rest, = to hold the note before."
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "volume",
                  "notes"
                ],
                "additionalProperties": false
              }
            ]
          },
          "description": "The parts that play together, each a row of steps."
        }
      },
      "required": [
        "format",
        "id",
        "tempo",
        "stepsPerBeat",
        "volume",
        "loop",
        "parts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "number",
          "const": 2,
          "description": "The version of this file format. 2 for loops, chords and motifs."
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "description": "A name for this track, like \"meadow\". It matches the file name."
        },
        "tempo": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300,
          "description": "Beats a minute, from 30 to 300."
        },
        "key": {
          "type": "string",
          "enum": [
            "C",
            "C#",
            "Db",
            "D",
            "D#",
            "Eb",
            "E",
            "F",
            "F#",
            "Gb",
            "G",
            "G#",
            "Ab",
            "A",
            "A#",
            "Bb",
            "B"
          ],
          "description": "The song's key: the note it is built on, like \"C\" or \"F#\"."
        },
        "mode": {
          "type": "string",
          "enum": [
            "major",
            "minor"
          ],
          "description": "\"major\" for a bright song, \"minor\" for a sad one."
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "How many bars the track lasts, from 1 to 128. A bar is four beats."
        },
        "loop": {
          "type": "boolean",
          "description": "True if the track starts again when it ends."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How loud the whole track is, from 0 (silent) to 1 (full)."
        },
        "chords": {
          "minItems": 1,
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:VII|VI|IV|V|III|II|I)|(?:vii|vi|iv|v|iii|ii|i)°?)(?:7|sus4)?$",
            "description": "A chord as a Roman numeral of the key, like \"I\", \"vi\", \"V7\" or \"IVsus4\"."
          },
          "description": "One chord for each bar, as numerals of the key."
        },
        "lanes": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "description": "A name for this lane, like \"drums\"."
              },
              "instrument": {
                "type": "string",
                "enum": [
                  "drums",
                  "bass",
                  "keys",
                  "pluck",
                  "lead",
                  "pad",
                  "bell",
                  "organ"
                ],
                "description": "What plays it: drums, bass, keys, pluck, lead, pad, bell or organ."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How loud this lane is, from 0 (silent) to 1 (full)."
              },
              "blocks": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 128,
                      "description": "The bar it starts at, counting from 1."
                    },
                    "loop": {
                      "description": "A loop to play, by id, like \"easy-drums\".",
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    },
                    "bars": {
                      "description": "For a loop: how many bars it fills.",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 128
                    },
                    "motif": {
                      "description": "A motif to play once, by id, like \"hero-theme\".",
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    },
                    "shift": {
                      "description": "Higher or lower, in whole steps of the key, -14 to 14.",
                      "type": "integer",
                      "minimum": -14,
                      "maximum": 14
                    },
                    "speed": {
                      "description": "How fast: 0.25, 0.5, 1, 2 or 4 times as fast. Left out, 1.",
                      "anyOf": [
                        {
                          "type": "number",
                          "const": 0.25
                        },
                        {
                          "type": "number",
                          "const": 0.5
                        },
                        {
                          "type": "number",
                          "const": 1
                        },
                        {
                          "type": "number",
                          "const": 2
                        },
                        {
                          "type": "number",
                          "const": 4
                        }
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "major",
                        "minor"
                      ],
                      "description": "\"major\" for a bright song, \"minor\" for a sad one."
                    },
                    "backwards": {
                      "description": "True to play the notes in the other order.",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "at"
                  ],
                  "additionalProperties": false
                },
                "description": "The loops and motifs it plays, each from its own bar."
              }
            },
            "required": [
              "id",
              "instrument",
              "volume",
              "blocks"
            ],
            "additionalProperties": false
          },
          "description": "The lines that play together, at most eight."
        }
      },
      "required": [
        "format",
        "id",
        "tempo",
        "key",
        "mode",
        "bars",
        "loop",
        "volume",
        "chords",
        "lanes"
      ],
      "additionalProperties": false
    }
  ],
  "title": "Music"
}
