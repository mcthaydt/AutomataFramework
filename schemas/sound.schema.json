{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1,
      "description": "The version of this file format. Always 1."
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "A name for this sound, like \"jump\". It matches the file name."
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "How loud the whole sound is, from 0 (silent) to 1 (full)."
    },
    "voices": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "tone",
                "description": "A pitch that slides from one note to another."
              },
              "wave": {
                "type": "string",
                "enum": [
                  "sine",
                  "square",
                  "sawtooth",
                  "triangle"
                ],
                "description": "The shape of the wave: how the tone sounds."
              },
              "from": {
                "type": "number",
                "minimum": 20,
                "maximum": 20000,
                "description": "The pitch it starts at, in hertz (20 to 20000)."
              },
              "to": {
                "type": "number",
                "minimum": 20,
                "maximum": 20000,
                "description": "The pitch it ends at, in hertz (20 to 20000)."
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Seconds after the sound starts that this voice starts."
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10,
                "description": "Seconds this voice lasts, more than 0 and at most 10."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How loud this voice is, from 0 (silent) to 1 (full)."
              }
            },
            "required": [
              "kind",
              "wave",
              "from",
              "to",
              "at",
              "length",
              "volume"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "noise",
                "description": "A hiss, like wind or a crash."
              },
              "pitch": {
                "type": "number",
                "minimum": 20,
                "maximum": 20000,
                "description": "The middle of the hiss, in hertz (20 to 20000)."
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Seconds after the sound starts that this voice starts."
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10,
                "description": "Seconds this voice lasts, more than 0 and at most 10."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How loud this voice is, from 0 (silent) to 1 (full)."
              }
            },
            "required": [
              "kind",
              "pitch",
              "at",
              "length",
              "volume"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "The voices that play together, each starting at its own time."
    }
  },
  "required": [
    "format",
    "id",
    "volume",
    "voices"
  ],
  "additionalProperties": false,
  "title": "Sound"
}
