{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1,
      "description": "The version of this file format. Always 1."
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "A name for this sound, like \"jump\". It matches the file name."
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "How loud the whole sound is, from 0 (silent) to 1 (full)."
    },
    "voices": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "tone",
                "description": "A pitch that slides from one note to another."
              },
              "wave": {
                "type": "string",
                "enum": [
                  "sine",
                  "square",
                  "sawtooth",
                  "triangle"
                ],
                "description": "The shape of the wave: how the tone sounds."
              },
              "from": {
                "type": "number",
                "minimum": 20,
                "maximum": 20000,
                "description": "The pitch it starts at, in hertz (20 to 20000)."
              },
              "to": {
                "type": "number",
                "minimum": 20,
                "maximum": 20000,
                "description": "The pitch it ends at, in hertz (20 to 20000)."
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Seconds after the sound starts that this voice starts."
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10,
                "description": "Seconds this voice lasts, more than 0 and at most 10."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How loud this voice is, from 0 (silent) to 1 (full)."
              }
            },
            "required": [
              "kind",
              "wave",
              "from",
              "to",
              "at",
              "length",
              "volume"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "noise",
                "description": "A hiss, like wind or a crash."
              },
              "pitch": {
                "type": "number",
                "minimum": 20,
                "maximum": 20000,
                "description": "The middle of the hiss, in hertz (20 to 20000)."
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Seconds after the sound starts that this voice starts."
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10,
                "description": "Seconds this voice lasts, more than 0 and at most 10."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How loud this voice is, from 0 (silent) to 1 (full)."
              }
            },
            "required": [
              "kind",
              "pitch",
              "at",
              "length",
              "volume"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "recording",
                "description": "A part of a recorded sound: a WAV file kept in the game."
              },
              "file": {
                "type": "string",
                "description": "The WAV file, as a path inside the game, like content/sounds/door.wav."
              },
              "from": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Seconds into the file that this voice starts from."
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10,
                "description": "Seconds this voice lasts, more than 0 and at most 10."
              },
              "speed": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2,
                "description": "How fast it plays: 0.5 (slower, lower) to 2 (faster, higher)."
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Seconds after the sound starts that this voice starts."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How loud this voice is, from 0 (silent) to 1 (full)."
              }
            },
            "required": [
              "kind",
              "file",
              "from",
              "length",
              "speed",
              "at",
              "volume"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "motif",
                "description": "A short tune, played by an instrument."
              },
              "motif": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "description": "Which motif to play, by id, like \"hero-theme\"."
              },
              "instrument": {
                "type": "string",
                "enum": [
                  "bass",
                  "keys",
                  "pluck",
                  "lead",
                  "pad",
                  "bell",
                  "organ"
                ],
                "description": "What plays it: \"bass\", \"keys\", \"pluck\", \"lead\", \"pad\", \"bell\" or \"organ\"."
              },
              "key": {
                "type": "string",
                "enum": [
                  "C",
                  "C#",
                  "Db",
                  "D",
                  "D#",
                  "Eb",
                  "E",
                  "F",
                  "F#",
                  "Gb",
                  "G",
                  "G#",
                  "Ab",
                  "A",
                  "A#",
                  "Bb",
                  "B"
                ],
                "description": "The song's key: the note it is built on, like \"C\" or \"F#\"."
              },
              "tempo": {
                "type": "integer",
                "minimum": 30,
                "maximum": 300,
                "description": "Beats a minute, from 30 to 300."
              },
              "shift": {
                "description": "Higher or lower, in whole steps of the key, -14 to 14.",
                "type": "integer",
                "minimum": -14,
                "maximum": 14
              },
              "speed": {
                "description": "How fast: 0.25, 0.5, 1, 2 or 4 times as fast. Left out, 1.",
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0.25
                  },
                  {
                    "type": "number",
                    "const": 0.5
                  },
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 4
                  }
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "major",
                  "minor"
                ],
                "description": "\"major\" for a bright song, \"minor\" for a sad one."
              },
              "backwards": {
                "description": "True to play the notes in the other order.",
                "type": "boolean"
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Seconds after the sound starts that this voice starts."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How loud this voice is, from 0 (silent) to 1 (full)."
              }
            },
            "required": [
              "kind",
              "motif",
              "instrument",
              "key",
              "tempo",
              "at",
              "volume"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "The voices that play together, each starting at its own time."
    }
  },
  "required": [
    "format",
    "id",
    "volume",
    "voices"
  ],
  "additionalProperties": false,
  "title": "Sound"
}
