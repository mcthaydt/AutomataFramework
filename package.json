{
  "name": "@automataframework/framework",
  "version": "0.1.0",
  "description": "A deterministic 2D game runtime for agents and editors.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/AutomataFramework.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p .",
    "knip": "knip",
    "test:node": "vitest run --project node",
    "test:engine": "vitest run --passWithNoTests --project",
    "build": "vite build && tsc -p tsconfig.build.json",
    "schemas": "node scripts/write-schemas.ts",
    "api-report": "node scripts/api-report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "knip": "6.39.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "0.21.0",
    "koota": "0.6.6",
    "pixi.js": "8.22.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.6"
  }
}
